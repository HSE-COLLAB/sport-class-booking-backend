  "item": [
    {
      "name": "00 Setup — Login Admin",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('accessToken present', () => pm.expect(j.accessToken).to.be.a('string'));",
                  "pm.test('refreshToken present', () => pm.expect(j.refreshToken).to.be.a('string'));",
                  "pm.collectionVariables.set('adminAccess', j.accessToken);",
                  "pm.collectionVariables.set('adminRefresh', j.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.local\",\n  \"password\": \"test1234\"\n}"
            }
          }
        }
      ]
    },
