    {"key": "baseUrl", "value": "http://localhost:8080/api"},
    {"key": "adminAccess", "value": ""},
    {"key": "adminRefresh", "value": ""},
    {"key": "adminId", "value": "99999999-9999-9999-9999-999999999999"},
    {"key": "teacher1Id", "value": "33333333-3333-3333-3333-333333333331"},
    {"key": "teacher2Id", "value": "33333333-3333-3333-3333-333333333332"},
    {"key": "student1Id", "value": "55555555-5555-5555-5555-555555555551"},
    {"key": "campusNN", "value": "3"},
    {"key": "lessonUpcomingId", "value": "20000000-0000-0000-0000-000000000001"},
    {"key": "createdGroupId", "value": ""},
    {"key": "createdWorkoutTypeId", "value": ""},
    {"key": "createdLessonId", "value": ""}
