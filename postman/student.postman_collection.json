    {
      "name": "05 Real-email — STUDENT (kravchi0803@yandex.ru)",
      "description": "Полный сценарий регистрации настоящего юзера через настоящую почту.\n\nКаждый раз перед запуском этого блока убедись, что в БД нет уже-верифицированного пользователя с email = kravchi0803@yandex.ru (иначе register вернёт 409). Удалить можно SQL: DELETE FROM students WHERE user_id IN (SELECT id FROM users WHERE email='kravchi0803@yandex.ru'); DELETE FROM users WHERE email='kravchi0803@yandex.ru';\n\nПорядок: register → (открыть письмо, скопировать token из ссылки) → положить в collection variable realStudentVerifyToken → verify → login → forgot-password → (открыть письмо, взять 6-значный PIN) → положить в realStudentResetPin → reset-password → login с новым паролем.",
      "item": [
        {
          "name": "1. Register student (real email)",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('202', () => pm.response.to.have.status(202));",
            "pm.test('email returned', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('realStudentEmail')));"
          ], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/register/student", "host": ["{{baseUrl}}"], "path": ["auth", "register", "student"]},
            "body": {"mode": "raw", "raw": "{\n  \"firstName\": \"Никита\",\n  \"lastName\": \"Кравченко\",\n  \"middleName\": \"Алексеевич\",\n  \"email\": \"{{realStudentEmail}}\",\n  \"password\": \"{{realStudentPassword}}\",\n  \"groupId\": \"{{groupId}}\",\n  \"campusId\": {{campusNN}}\n}"}
          }
        },
        {
          "name": "2. Login до верификации → 401",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('401', () => pm.response.to.have.status(401));"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\",\n  \"password\": \"{{realStudentPassword}}\"\n}"}
          }
        },
        {
          "name": "3. Resend verification",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('204', () => pm.response.to.have.status(204));"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/resend-verification", "host": ["{{baseUrl}}"], "path": ["auth", "resend-verification"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\"\n}"}
          }
        },
        {
          "name": "4. ⚠ Verify email (ВПИСАТЬ token из последнего письма в realStudentVerifyToken)",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('204 (или 400 если token не подставлен)', () => pm.expect([204, 400]).to.include(pm.response.code));"
          ], "type": "text/javascript"}}],
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/auth/verify-email?token={{realStudentVerifyToken}}", "host": ["{{baseUrl}}"], "path": ["auth", "verify-email"], "query": [{"key": "token", "value": "{{realStudentVerifyToken}}"}]}
          }
        },
        {
          "name": "5. Login после верификации → 200",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('access token present', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));"
          ], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\",\n  \"password\": \"{{realStudentPassword}}\"\n}"}
          }
        },
        {
          "name": "6. Forgot password",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('204', () => pm.response.to.have.status(204));"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\"\n}"}
          }
        },
        {
          "name": "7. ⚠ Reset password (ВПИСАТЬ 6-значный PIN из письма в realStudentResetPin)",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('204 (или 400 если PIN не подставлен)', () => pm.expect([204, 400]).to.include(pm.response.code));"
          ], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth", "reset-password"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\",\n  \"code\": \"{{realStudentResetPin}}\",\n  \"newPassword\": \"{{realStudentNewPassword}}\"\n}"}
          }
        },
        {
          "name": "8. Login с новым паролем → 200",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('200', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\",\n  \"password\": \"{{realStudentNewPassword}}\"\n}"}
          }
        },
        {
          "name": "9. Login со старым паролем → 401",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('401', () => pm.response.to.have.status(401));"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{realStudentEmail}}\",\n  \"password\": \"{{realStudentPassword}}\"\n}"}
