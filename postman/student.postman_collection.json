          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{student1Access}}"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/students/{{student1Id}}/self-update", "host": ["{{baseUrl}}"], "path": ["students", "{{student1Id}}", "self-update"]},
