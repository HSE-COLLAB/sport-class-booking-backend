    {
      "name": "00 Setup — Login Student",
      "item": [
        {
          "name": "Login student1 (health group 1)",
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('student1Access', j.accessToken);",
            "pm.collectionVariables.set('student1Refresh', j.refreshToken);"
          ], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"student1@test.local\",\n  \"password\": \"test1234\"\n}"}
          }
        },
        {
          "name": "Login student4 (health group 5) — для error сценариев",
