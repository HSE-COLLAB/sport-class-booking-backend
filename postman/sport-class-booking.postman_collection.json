  "item": [
    {
      "name": "Auth (public)",
      "description": "Публичные ручки — работают без авторизации",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has accessToken', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.refreshToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/student", "host": ["{{baseUrl}}"], "path": ["auth", "register", "student"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"New\",\n  \"lastName\": \"Student\",\n  \"middleName\": \"Test\",\n  \"email\": \"newstudent@mail.ru\",\n  \"password\": \"password123\",\n  \"groupId\": \"{{studentGroupId}}\",\n  \"campusId\": 3\n}"
            }
          }
        },
        {
          "name": "Register Student (conflict - existing email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/student", "host": ["{{baseUrl}}"], "path": ["auth", "register", "student"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Dup\",\n  \"lastName\": \"User\",\n  \"middleName\": \"T.\",\n  \"email\": \"student1@mail.ru\",\n  \"password\": \"password\",\n  \"groupId\": \"{{studentGroupId}}\",\n  \"campusId\": 3\n}"
            }
          }
        },
        {
          "name": "Register Student (invalid campus)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/student", "host": ["{{baseUrl}}"], "path": ["auth", "register", "student"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"X\",\n  \"lastName\": \"Y\",\n  \"middleName\": \"Z\",\n  \"email\": \"unique999@mail.ru\",\n  \"password\": \"password\",\n  \"groupId\": \"{{studentGroupId}}\",\n  \"campusId\": 9999\n}"
            }
          }
        },
        {
          "name": "Register Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register/teacher", "host": ["{{baseUrl}}"], "path": ["auth", "register", "teacher"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"New\",\n  \"lastName\": \"Teacher\",\n  \"middleName\": \"Test\",\n  \"email\": \"newteacher@mail.ru\",\n  \"password\": \"password123\",\n  \"position\": \"Доцент\",\n  \"campusId\": 1\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@mail.ru\",\n  \"password\": \"test\"\n}"
            }
          }
        },
        {
          "name": "Login (wrong password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@mail.ru\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Refresh-Token", "value": "{{refreshToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 204', () => pm.response.to.have.status(204));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Refresh-Token", "value": "{{refreshToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
