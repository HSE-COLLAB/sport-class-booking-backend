    {
      "name": "As TEACHER",
      "description": "Установить в application-local.yml: `security.development.default-user.role: TEACHER`\n\nИспользуется Teacher1 (НН, кампус 3). Все уроки будут создаваться автоматически в его кампусе.",
      "item": [
        {
          "name": "GET /lessons — 200",
          "event": [{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));"],"type":"text/javascript"}}],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/lessons", "host": ["{{baseUrl}}"], "path": ["lessons"] } }
        },
        {
          "name": "POST /lessons — 201 (создаётся в кампусе Teacher1)",
          "event": [{"listen":"test","script":{"exec":[
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const lesson = pm.response.json();",
            "pm.test('Teacher is Teacher1', () => pm.expect(lesson.teacher.id).to.eql(pm.collectionVariables.get('teacher1Id')));",
            "pm.test('Campus is NN (3)', () => pm.expect(lesson.campus.id).to.eql(3));",
            "pm.collectionVariables.set('createdLessonId', lesson.id);"
          ],"type":"text/javascript"}}],
          "request": {
